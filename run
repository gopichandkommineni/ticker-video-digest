#!/usr/bin/env bash
#
# ./run — the one command you need for everyday work on this project.
#
# Everything here is a friendly wrapper around a longer command you could
# also type by hand. Run `./run` with no arguments to see the menu.
#
set -euo pipefail
cd "$(dirname "$0")"

VENV=".venv"
PY="$VENV/bin/python"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '\033[33m!\033[0m %s\n' "$1"; }
die()  { printf '\033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }

need_venv() {
  [ -x "$PY" ] || die "No Python environment found. Run:  ./run setup"
}

cmd_help() {
  cat <<'EOF'

  Casino Dashboard — command menu

    ./run setup        Install everything. Do this once, first.
    ./run dashboard    Open the dashboard in your web browser.
    ./run test         Run the automated checks.
    ./run lint         Structure guard: are files and functions readable-sized?
    ./run check        Health check: is this machine set up correctly?
    ./run market       Print the "is the market expensive?" report in the terminal.
    ./run refresh      Download fresh data into a THROWAWAY local database.
                       (The real data is refreshed automatically on GitHub.)
    ./run clean        Delete caches and throwaway files. Safe.

  New to the project? Start with README.md, then docs/start-here/.

EOF
}

cmd_setup() {
  bold "Setting up the project…"
  if command -v uv >/dev/null 2>&1; then
    echo "Using uv (fast installer)."
    uv venv --python 3.11 "$VENV" 2>/dev/null || true
    uv pip install --python "$PY" -e ".[dev]"
  else
    echo "uv not found — using plain Python. This is slower but works."
    command -v python3 >/dev/null 2>&1 || die "Python 3 is not installed. Install Python 3.11 first."
    [ -d "$VENV" ] || python3 -m venv "$VENV"
    "$PY" -m pip install --quiet --upgrade pip
    "$PY" -m pip install -e ".[dev]"
  fi
  ok "Installed."
  [ -f .env ] || { cp .env.example .env && warn "Created a blank .env — see docs/start-here/02-get-it-running.md"; }
  echo
  echo "Next:  ./run dashboard"
}

cmd_dashboard() {
  need_venv
  bold "Starting the dashboard…"
  echo "It will open at http://localhost:8501 — press Ctrl+C here to stop it."
  echo
  "$VENV/bin/streamlit" run app.py
}

cmd_test() {
  need_venv
  bold "Running the automated checks (skipping ones that need the internet)…"
  "$PY" -m pytest -q -m "not integration" "$@"
}

cmd_lint() {
  # Uses only the standard library, so it works even before ./run setup.
  local py="$PY"
  [ -x "$py" ] || py="$(command -v python3)"
  [ -n "$py" ] || die "Python 3 is not installed."
  bold "Checking file and function sizes…"
  "$py" scripts/check_structure.py
}

cmd_market() {
  need_venv
  "$PY" -m ticker_digest market --thesis
}

cmd_refresh() {
  need_venv
  local target="data/local-test.db"
  bold "Refreshing into $target (a throwaway copy — production data is untouched)."
  warn "This calls real websites and takes several minutes."
  [ -f data/snapshots.db ] && cp data/snapshots.db "$target"
  "$PY" - "$target" <<'PYCODE'
import sys
from pathlib import Path
from casino_dashboard.jobs.daily_refresh import main
main(Path(sys.argv[1]))
PYCODE
  ok "Done. Results are in $target (git ignores it)."
}

cmd_check() {
  bold "Health check"
  if [ -x "$PY" ]; then ok "Python environment: $("$PY" --version)"; else warn "No environment yet — run ./run setup"; fi
  [ -f config/themes.yaml ] && ok "Universe config present" || warn "config/themes.yaml is MISSING"
  [ -f data/snapshots.db ] && ok "Dashboard database present ($(du -h data/snapshots.db | cut -f1))" || warn "data/snapshots.db missing — the dashboard will be empty"
  [ -f .env ] && ok ".env file present" || warn "No .env file — optional, but some features stay off"
  if [ -x "$PY" ]; then
    "$PY" - <<'PYCODE'
import sys
sys.path.insert(0, "src")
try:
    from casino_dashboard.universe import load_universe
    u = load_universe()
    print(f"\033[32m✓\033[0m Universe loads: {len(u.sectors)} themes, {len(u.all_tickers())} stocks")
except Exception as exc:
    print(f"\033[31m✗\033[0m Universe failed to load: {exc}")
PYCODE
  fi
  echo
  echo "If anything above is a ! or ✗, see docs/start-here/07-when-things-break.md"
}

cmd_clean() {
  bold "Cleaning caches and throwaway files…"
  find . -name '__pycache__' -type d -not -path './.venv/*' -prune -exec rm -rf {} + 2>/dev/null || true
  rm -rf .pytest_cache .ruff_cache
  rm -f data/local-test.db data/local-test.db-wal data/local-test.db-shm
  ok "Clean. (Your .venv, your data, and your .env were left alone.)"
}

case "${1:-help}" in
  setup)      shift; cmd_setup "$@" ;;
  dashboard|start|app) shift; cmd_dashboard "$@" ;;
  test|tests) shift; cmd_test "$@" ;;
  lint|structure) shift; cmd_lint "$@" ;;
  check|doctor) shift; cmd_check "$@" ;;
  market)     shift; cmd_market "$@" ;;
  refresh)    shift; cmd_refresh "$@" ;;
  clean)      shift; cmd_clean "$@" ;;
  help|-h|--help) cmd_help ;;
  *) printf '\033[31mUnknown command: %s\033[0m\n' "$1"; cmd_help; exit 1 ;;
esac
