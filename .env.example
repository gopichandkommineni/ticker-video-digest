# Copy this file to `.env` and fill in the keys you actually need.
#
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Every key below is
# optional — the dashboard opens and works without any of them, it just
# turns off the features that need them.
#
# In production these same values live as GitHub Actions *secrets*, not in
# a file. See docs/start-here/04-how-the-data-flows.md.

# ---------------------------------------------------------------------------
# Most useful first
# ---------------------------------------------------------------------------

# Claude, for the written market thesis on the Market Reality Check page and
# for the YouTube digest. https://console.anthropic.com/
#
# The YouTube digest can run WITHOUT this: if it's empty and you have the
# Claude Code CLI installed and logged in, the digest shells out to that
# instead. See TICKER_DIGEST_LLM_BACKEND below. The market thesis still needs
# a key (or `ant auth login`).
ANTHROPIC_API_KEY=

# US economic data (unemployment, CPI, yield curve …). Free, instant signup.
# Without it, the Market Reality Check still works but uses market data only.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Reddit chatter (the "social mentions" numbers)
# ---------------------------------------------------------------------------
# Reddit closed its public API in 2026, so the project reads managed archives
# instead. Read docs/runbooks/reddit-local-runbook.md before touching these.

REDDIT_BACKEND=          # arctic_shift (default, free) | apify | praw
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
APIFY_TOKEN=
APIFY_REDDIT_ACTOR=

# ---------------------------------------------------------------------------
# FinTwit tweet pipeline (src/fintwit/) — only if you run that pipeline
# ---------------------------------------------------------------------------
TWEET_PROVIDER=          # getxapi | twitterapi
GETXAPI_KEY=
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Extra market data providers (used by some pages and research probes)
# ---------------------------------------------------------------------------
FMP_API_KEY=
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# YouTube insight threads (src/ticker_digest/)
# ---------------------------------------------------------------------------
# Needed by `python -m ticker_digest ticker RKLB`, together with
# ANTHROPIC_API_KEY above. Free quota from the Google Cloud console — enable
# "YouTube Data API v3". See docs/specs/youtube-insight-threads-v1.md.
YOUTUBE_API_KEY=

# Optional. Where digest runs, claims and threads are stored.
# Default: data/digests.db (git-ignored).
TICKER_DIGEST_DB=

# Optional. Pin the two passes to specific models without a code change.
# Defaults: claude-sonnet-4-6 per video, claude-opus-4-7 for the thread.
TICKER_DIGEST_EXTRACTION_MODEL=
TICKER_DIGEST_SYNTHESIS_MODEL=

# Optional. How the digest reaches Claude:
#   auto (default) — the API when ANTHROPIC_API_KEY is set AND accepted; the
#                    Claude Code CLI otherwise. A placeholder key is fine: the
#                    first 401 demotes the run to the CLI.
#   api            — always the Anthropic SDK
#   cli            — always the Claude Code CLI (no API key needed; it uses
#                    whatever account `claude` is logged in as)
TICKER_DIGEST_LLM_BACKEND=
# Where the Claude Code CLI lives, if it isn't just `claude` on your PATH.
TICKER_DIGEST_CLAUDE_CLI=
# Seconds to wait for one CLI call before giving up. Default 600.
TICKER_DIGEST_CLAUDE_CLI_TIMEOUT=

# ---------------------------------------------------------------------------
# Research probes only (research/) — not needed to run the dashboard
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
